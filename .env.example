# Required: the passcode you type on your phone to unlock lazylink (8+ characters).
LAZYLINK_PASSCODE=

# Your Tailscale login(s), comma-separated. Requests from any other tailnet user are rejected.
LAZYLINK_ALLOWED_USERS=

# Default model as provider/model. Leave empty to use the first free model opencode offers.
# Examples: opencode/nemotron-3-ultra-free   ollama/qwen3-coder:30b   openrouter/<model>
LAZYLINK_MODEL=

# Where the agent works. Defaults to your home folder.
# LAZYLINK_WORKDIR=/Users/you

# Agent Chrome: "auto" launches it with lazylink, "manual" waits for the button in the app.
# LAZYLINK_CHROME=auto
# LAZYLINK_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Ports (both bound to 127.0.0.1 only).
# LAZYLINK_PORT=8787
# OPENCODE_PORT=4096

# Use an opencode server you run yourself instead of letting lazylink spawn one.
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=
